# Copy to .env and adjust values
APP_NAME=PropTech API
DEBUG=true

# SQLite for local dev; use PostgreSQL in production, e.g.:
# DATABASE_URL=postgresql+psycopg://user:password@localhost:5432/proptech
DATABASE_URL=sqlite:///./proptech.db

# S3-compatible object storage
S3_ENDPOINT_URL=
S3_BUCKET=proptech-media
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# Analytics / AI (later phases)
POSTHOG_KEY=
OPENAI_API_KEY=

# Auth (builder dashboard) — generate with: openssl rand -hex 32
JWT_SECRET_KEY=change-me-in-production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=720
