# Copy to .env and adjust values
APP_NAME=PropTech API
DEBUG=true

# SQLite for local dev; use PostgreSQL in production, e.g.:
# DATABASE_URL=postgresql+psycopg://user:password@localhost:5432/proptech
DATABASE_URL=sqlite:///./proptech.db

# CORS (comma-separated origins, empty = localhost:3000 + localhost:8081)
CORS_ORIGINS=

# S3-compatible object storage
S3_ENDPOINT_URL=
S3_BUCKET=proptech-media
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# Analytics / AI (later phases)
POSTHOG_KEY=
OPENAI_API_KEY=
# AI Property Assistant — model string for pydantic-ai.
# Examples: openai:gpt-4o-mini | anthropic:claude-sonnet-4-5 | google-gla:gemini-2.5-flash
# Leave empty to auto-use OpenAI when a key is set; with no key the DB-grounded rule engine answers.
AI_MODEL=

# Auth (builder dashboard) — generate with: openssl rand -hex 32
JWT_SECRET_KEY=change-me-in-production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=720
